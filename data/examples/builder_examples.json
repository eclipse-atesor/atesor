      "name": "Simple Go Build - All Phases Succeed",
      "tags": [
        "go",
        "simple",
        "success"
      ],
      "build_system": "go",
      "source": "manual",
      "repo_name": "shcopy",
      "phases": [
        {
          "name": "install",
          "commands": [
            "apk update",
            "apk add go"
          ]
        },
        {
          "name": "build",
          "commands": [
            "go mod tidy",
            "go build -buildvcs=false -v -o shcopy ."
          ]
        }
      ],
      "timeout_recommendation": "60s",
      "reasoning": "Simple project, fast build. Total time ~33 seconds."
