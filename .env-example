# Copy to .env (or ~/.config/atesor-ai/.env) and fill in.
# Only the key for your selected LLM_PROVIDER is required.

# ---- LLM provider ----------------------------------------------------
LLM_PROVIDER=openrouter          # gemini | openai | openrouter
OPENAI_API_KEY=your_key_here
GOOGLE_API_KEY=your_key_here
OPENROUTER_API_KEY=your_key_here

# Ordered fallback chain used when a free-tier model is rate-limited or
# retired. `openrouter/free` is always appended automatically.
OPENROUTER_FALLBACK_MODELS=qwen/qwen3-coder:free,openai/gpt-oss-120b:free,meta-llama/llama-3.3-70b-instruct:free

# Optional LLM tuning.
# ATESOR_MAX_OUTPUT_TOKENS=8192  # per-call output cap
# ATESOR_LLM_TIMEOUT=120         # provider HTTP timeout (seconds)

# ---- LangSmith tracing (optional) ------------------------------------
# Read by the LangChain SDK itself, not by atesor-ai code.
LANGCHAIN_TRACING_V2=true
LANGCHAIN_API_KEY=your_key_here

# ---- Git access ------------------------------------------------------
# Required only for cloning PRIVATE GitHub repositories. The token is
# scoped to https://github.com/ and injected per-clone; it is never
# written to the sandbox's git config.
# GIT_TOKEN=your_token_here      # GH_TOKEN is also accepted

# ---- Runtime state / sandbox selection -------------------------------
# Base directory for workspace, logs, recipe cache and learned examples.
# Default: $XDG_DATA_HOME/atesor-ai (i.e. ~/.local/share/atesor-ai), or
# the source checkout when running from a clone.
# ATESOR_HOME=/var/lib/atesor-ai

# Override the sandbox platform profile (same values as --platform).
# ATESOR_PLATFORM=debian         # alpine | debian | ubuntu

# Override the sandbox container name (same as --container). batch runs
# use this to give each worker its own container.
# ATESOR_CONTAINER=atesor-ai-sandbox-w1

# Force a sandbox image rebuild on the next run (same as --rebuild).
# REBUILD_IMAGE=true
